{
  "mcpServers": {
    "grafana": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/helpers/grafana.sh",
      "env": {
        "GRAFANA_URL": "https://grafana.hq.growse.com"
      }
    },
    "homeassistant": {
      "type": "sse",
      "url": "https://homeassistant.hq.growse.com/mcp_server/sse",
      "headersHelper": "${CLAUDE_PLUGIN_ROOT}/helpers/homeassistant-headers.sh"
    },
    "victoriametrics": {
      "type": "http",
      "url": "https://metrics.hq.growse.com/mcp"
    },
    "paperless": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/helpers/paperless.sh",
      "env": {
        "PAPERLESS_URL": "https://paperless.hq.growse.com"
      }
    },
    "tailscale": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/helpers/tailscale.sh",
      "env": {
        "TAILSCALE_TAILNET": "-"
      }
    },
    "unifi-network": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/helpers/unifi-network.sh",
      "env": {
        "UNIFI_NETWORK_HOST": "unifi.hq.growse.com",
        "UNIFI_NETWORK_PORT": "443",
        "UNIFI_NETWORK_SITE": "default",
        "UNIFI_NETWORK_VERIFY_SSL": "true",
        "UNIFI_TOOL_REGISTRATION_MODE": "lazy"
      }
    }
  }
}
