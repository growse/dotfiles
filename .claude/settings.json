{
  "env": {
    "UNIFI_NETWORK_HOST": "unifi.hq.growse.com",
    "UNIFI_NETWORK_USERNAME": "growse",
    "UNIFI_NETWORK_PASSWORD": "tributary-starved-onion-gnat"
  },
  "permissions": {
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl version *)",
      "Bash(kubectl kustomize *)",
      "Bash(npm info *)",
      "Bash(npm view *)",
      "Read(//tmp/**)",
      "Bash(awk)",
      "Bash(ls)",
      "Bash(find)",
      "Bash(tail)",
      "Bash(head)",
      "Bash(echo)",
      "Bash(ping)",
      "Bash(ls)",
      "Bash(find)",
      "Bash(sed)",
      "Bash(grep)",
      "Bash(echo)",
      "Bash(cargo)",
      "Bash(xargs)",
      "Bash(stern)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(git push)"
    ]
  },
  "enabledPlugins": {
    "kubernetes-skill@kubernetes-skill": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "monzo@tcoretech": true,
    "unifi-network@unifi-plugins": true
  },
  "extraKnownMarketplaces": {
    "kubernetes-skill": {
      "source": {
        "source": "github",
        "repo": "LukasNiessen/kubernetes-skill"
      }
    },
    "tcoretech": {
      "source": {
        "source": "git",
        "url": "https://github.com/tcoretech/monzo-mcp.git"
      }
    },
    "unifi-plugins": {
      "source": {
        "source": "github",
        "repo": "sirkirby/unifi-mcp"
      }
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true
}
